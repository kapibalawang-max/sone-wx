{
  "name": "sone-wx",
  "version": "1.41.4",
  "private": true,
  "description": "SONE主题：微信风格皮肤 + 品牌自定义（独立设置分区）。",
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "icon.svg"
  ],
  "engines": {
    "node": ">=20.11"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [],
      "platform": "web",
      "immediately": true
    },
    "compatibility": {
      "dshReleases": {
        "0.2.2-rc.1": "compatible",
        "0.2.2-rc.2": "compatible"
      }
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-store": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-locale": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-theme": ">=0.2.2-rc.1 <0.3.0-0",
    "@deepseek-ai/dsh-client-ui-settings": ">=0.2.2-rc.1 <0.3.0-0",
    "react": "^18.2.0"
  },
  "license": "MIT",
  "devDependencies": {
    "playwright": "^1.48.0"
  },
  "scripts": {
    "test": "node test/run-all.mjs",
    "test:fixtures": "node test/fixtures.mjs",
    "test:visual": "node test/visual.mjs",
    "test:update-baseline": "node test/visual.mjs --update"
  }
}
